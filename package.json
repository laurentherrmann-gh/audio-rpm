{
  "name": "audio-rpm",
  "version": "0.1.0",
  "private": true,
  "description": "POC: estimate engine RPM from game audio (gyroball-rpm vs pitch-detection) and feed it to SimHub as DiRT Rally 2.0 UDP telemetry",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "listen": "node tools/udp-listen.js",
    "make-wav": "node tools/make-test-wav.js",
    "test": "node --test test/*.test.js",
    "bench": "node tools/bench.js",
    "analyze": "node tools/analyze.js",
    "fetch-dr2": "node tools/fetch-dr2.js",
    "eval-dr2": "node tools/eval-dr2.js",
    "learn-cars": "node tools/cars.js learn",
    "eval-cars": "node tools/cars.js eval",
    "test:ui": "node test/ui/smoke.mjs"
  },
  "dependencies": {
    "pitch-detection": "^1.0.0",
    "ws": "^8.18.0"
  }
}
